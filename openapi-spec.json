  "info": {
    "title": "Nobstacle API",
    "description": "",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "Authentication": {
        "type": "apiKey",
        "in": "cookie",
        "name": "Authentication"
      },
      "Refresh": { "type": "apiKey", "in": "cookie", "name": "Refresh" }
    },
    "schemas": {
      "HttpExceptionSchema": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "statusCode": { "type": "number" },
          "error": { "type": "string" }
        },
        "required": ["message", "statusCode", "error"]
      },
      "GetUserRes": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "email": { "type": "string", "nullable": true },
          "firstName": { "type": "string", "nullable": true },
          "lastName": { "type": "string", "nullable": true },
          "createdAt": { "format": "date-time", "type": "string" },
          "updatedAt": { "format": "date-time", "type": "string" },
          "emailVerified": { "type": "boolean" },
          "locale": {
            "type": "string",
            "enum": ["en", "fr", "es"],
            "nullable": true
          },
          "Role": {
            "type": "string",
            "enum": ["Admin", "Staff", "User"],
            "nullable": true
          }
        },
        "required": [
          "id",
          "email",
          "firstName",
          "lastName",
          "createdAt",
          "updatedAt",
          "emailVerified",
          "locale",
          "Role"
        ]
      },
      "PostUserReq": {
        "type": "object",
        "properties": {
          "password": { "type": "string" },
          "email": { "type": "string" },
          "firstName": { "type": "string", "nullable": true },
          "lastName": { "type": "string", "nullable": true },
          "locale": {
            "type": "string",
            "enum": ["en", "fr", "es"],
            "default": "en"
          }
        },
        "required": ["password", "email", "locale"]
      },
      "PatchUserReq": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "nullable": true },
          "password": {
            "type": "string",
            "nullable": true,
            "description": "Required if email, cryptoWallet isn't null"
          },
          "firstName": { "type": "string", "nullable": true },
          "lastName": { "type": "string", "nullable": true },
          "newPassword": { "type": "string", "nullable": true },
          "oldPassword": {
            "type": "string",
            "nullable": true,
            "description": "Required if newPassword is not null"
          },
          "locale": { "type": "string", "enum": ["en", "fr", "es"] }
        }
      },
      "DeleteUserAccountRes": {
        "type": "object",
        "properties": { "success": { "type": "boolean" } },
        "required": ["success"]
      },
      "LoginReq": {
        "type": "object",
        "properties": {
          "emailOrUsername": { "type": "string" },
          "password": { "type": "string" },
          "timezone": {
            "type": "string",
            "description": "The user current timezone, ex: Europe/Amsterdam"
          }
        },
        "required": ["emailOrUsername", "password"]
      },
      "RefreshReq": {
        "type": "object",
        "properties": {
          "timezone": {
            "type": "string",
            "description": "The user current timezone, ex: Europe/Amsterdam"
          }
        }
      },
      "GetUploadFileRes": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "nullable": true,
            "description": "Uploaded file id, nullable for landmark uploads"
          },
          "source": {
            "type": "string",
            "description": "Uploaded file source url"
          }
        },
        "required": ["id", "source"]
      },
      "GetUploadsFilesRes": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "description": "Total number of uploads"
          },
          "uploads": {
            "description": "Array of uploads",
            "type": "array",
            "items": { "$ref": "#/components/schemas/GetUploadFileRes" }
          }
        },
        "required": ["total", "uploads"]
      },
      "DeleteUploadFileReq": {
        "type": "object",
        "properties": { "source": { "type": "string", "nullable": false } },
        "required": ["source"]
      },
      "PostCompanyReq": {
        "type": "object",
        "properties": { "name": { "type": "string", "nullable": false } },
        "required": ["name"]
      },
      "GetCompanyRes": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "defaultLangCode": { "type": "string" }
        },
        "required": ["id", "name", "defaultLangCode"]
      },
      "GetTextTemplateRes": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "description": { "type": "string" },
          "langCode": { "type": "string" },
          "title": { "type": "string" },
          "tagId": { "type": "number" }
        },
        "required": ["id", "description", "langCode", "title", "tagId"]
      },
      "GetImageTemplates": { "type": "object", "properties": {} },
      "GetMapTemplates": { "type": "object", "properties": {} },
      "GetCompanyTemplatesRes": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "defaultLangCode": { "type": "string" },
          "TextTemplates": {
            "description": "text template records",
            "type": "array",
            "items": { "$ref": "#/components/schemas/GetTextTemplateRes" }
          },
          "ImageTemplates": {
            "description": "image template records",
            "type": "array",
            "items": { "$ref": "#/components/schemas/GetImageTemplates" }
          },
          "MapTemplates": {
            "description": "map template records",
            "type": "array",
            "items": { "$ref": "#/components/schemas/GetMapTemplates" }
          }
        },
        "required": [
          "id",
          "name",
          "defaultLangCode",
          "TextTemplates",
          "ImageTemplates",
          "MapTemplates"
        ]
      },
      "PostTextTemplateReq": {
        "type": "object",
        "properties": {
          "description": { "type": "string", "nullable": false },
          "title": { "type": "string", "nullable": false },
          "langCode": { "type": "string", "nullable": false },
          "companyId": { "type": "integer", "nullable": false },
          "tagId": { "type": "integer", "nullable": false },
          "tagLabel": { "type": "string", "nullable": false }
        },
        "required": ["description", "langCode", "companyId"]
      },
      "PostTagTemplate": {
        "type": "object",
        "properties": {
          "label": { "type": "string", "nullable": false },
          "companyId": { "type": "number", "nullable": false }
        },
        "required": ["label", "companyId"]
      },
      "GetTagRes": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "label": { "type": "string" }
        },
        "required": ["id", "label"]
      }
    }
  }
}
